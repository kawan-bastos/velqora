                                                <TextBlock Text="Atalhos globais" FontSize="19" FontWeight="SemiBold"/>
                                                <TextBlock Text="Configure os atalhos que funcionam em qualquer aplicativo." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                                        <ItemsControl x:Name="HotkeyItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="76"/>
                                                                <ColumnDefinition Width="12"/>
                                                                <ColumnDefinition Width="112"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" FontSize="13"/>
                                                            <Border Grid.Column="1" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4,8">
                                                                <TextBlock Text="{Binding Value, TargetNullValue=Desativado}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Button Grid.Column="3" Content="Alterar" Style="{StaticResource SecondaryButtonStyle}" Height="48" Padding="8,0" Click="ChangeHotkey_Click" AutomationProperties.Name="{Binding Label}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="HotkeyCaptureStatus" Foreground="#D9C69E" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource SettingsFeedbackStyle}"/>
                                        <TextBlock x:Name="HotkeyStatus" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource SettingsFeedbackStyle}"/>
                                        <Button Content="Restaurar atalhos padrão" Style="{StaticResource SecondaryButtonStyle}" Margin="0,22,0,0" Click="RestoreHotkeys_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}" Tag="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{StaticResource AccentBrightBrush}" Margin="0,3,0,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Aparência" FontSize="19" FontWeight="SemiBold"/>
                                                <TextBlock Text="Identidade visual do aplicativo." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                                        <Grid Margin="38,12,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Tema atual" VerticalAlignment="Center" FontSize="14" Margin="0,0,18,0"/>
                                            <Border Grid.Column="1" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                                <TextBlock Text="Preto e dourado"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Este é o tema disponível nesta versão do Velqora." Style="{StaticResource SettingsNoteStyle}" Margin="38,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="SettingsRightColumn" Grid.Column="1">
                                <Border Style="{StaticResource SettingsCardStyle}" Tag="2">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{StaticResource AccentBrightBrush}" Margin="0,3,0,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Dados e segurança" FontSize="19" FontWeight="SemiBold"/>
                                                <TextBlock Text="Gerencie seus presets e cópias de segurança." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                                        <Button Style="{StaticResource SettingsActionButtonStyle}" Click="ExportPresets_Click" ToolTip="Salvar uma cópia de todos os presets em JSON." AutomationProperties.Name="Exportar presets">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentBrightBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Exportar presets" VerticalAlignment="Center" FontSize="14"/>
                                                <TextBlock Grid.Column="2" Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SettingsActionButtonStyle}" Margin="0,8,0,0" Click="ImportPresets_Click" ToolTip="Importar arquivos JSON ou CFG legados." AutomationProperties.Name="Importar presets">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentBrightBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Importar presets" VerticalAlignment="Center" FontSize="14"/>
                                                <TextBlock Grid.Column="2" Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SettingsActionButtonStyle}" Margin="0,8,0,0" Click="CreateBackup_Click" ToolTip="Criar um backup do arquivo atual de presets." AutomationProperties.Name="Criar backup agora">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentBrightBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Criar backup agora" VerticalAlignment="Center" FontSize="14"/>
                                                <TextBlock Grid.Column="2" Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SettingsActionButtonStyle}" Margin="0,8,0,0" Click="RestoreBackup_Click" ToolTip="Selecionar e restaurar um backup anterior." AutomationProperties.Name="Restaurar backup">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentBrightBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Restaurar backup" VerticalAlignment="Center" FontSize="14"/>
                                                <TextBlock Grid.Column="2" Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="OpenDataFolderButton" Style="{StaticResource SettingsActionButtonStyle}" Margin="0,8,0,0" Click="OpenDataFolder_Click" ToolTip="Abrir a pasta onde ficam os presets, atalhos e backups." AutomationProperties.Name="Abrir local do arquivo">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentBrightBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Abrir local do arquivo" VerticalAlignment="Center" FontSize="14"/>
                                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                            </Grid>
                                        </Button>
                                        <TextBlock x:Name="TransferFeedbackText" Foreground="#7EE2A8" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource SettingsFeedbackStyle}"/>
                                        <TextBlock Text="Seus presets e backups são armazenados localmente. Exporte uma cópia para guardá-los em outro local." Style="{StaticResource SettingsNoteStyle}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}" Tag="3">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{StaticResource AccentBrightBrush}" Margin="0,3,0,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Atualizações" FontSize="19" FontWeight="SemiBold"/>
                                                <TextBlock Text="Mantenha o Velqora na versão mais recente." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="InstalledVersionText" Foreground="White" FontSize="12"/>
                                        <TextBlock x:Name="UpdateStatusText" Text="Nenhuma verificação realizada nesta sessão." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="LastUpdateCheckText" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                                        <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="8" Foreground="{StaticResource AccentBrush}" Background="{StaticResource ElevatedBrush}" Margin="0,14,0,0" Visibility="Collapsed"/>
                                        <CheckBox x:Name="AutoUpdateCheck" Content="Verificar atualizações automaticamente" Style="{StaticResource ModernCheckStyle}" Margin="0,18,0,0" Checked="UpdatePreference_Changed" Unchecked="UpdatePreference_Changed"/>
                                        <CheckBox x:Name="OpenAfterUpdateCheck" Content="Abrir o aplicativo após atualizar" Style="{StaticResource ModernCheckStyle}" Margin="0,9,0,0" Checked="UpdatePreference_Changed" Unchecked="UpdatePreference_Changed"/>
                                        <CheckBox x:Name="AskBeforeDownloadCheck" Content="Perguntar antes de baixar" Style="{StaticResource ModernCheckStyle}" Margin="0,9,0,0" Checked="UpdatePreference_Changed" Unchecked="UpdatePreference_Changed"/>
                                        <CheckBox x:Name="AskBeforeInstallCheck" Content="Perguntar antes de instalar" Style="{StaticResource ModernCheckStyle}" Margin="0,9,0,0" Checked="UpdatePreference_Changed" Unchecked="UpdatePreference_Changed"/>
                                        <CheckBox x:Name="KeepPreviousVersionCheck" Content="Manter uma cópia da versão anterior" Style="{StaticResource ModernCheckStyle}" Margin="0,9,0,0" Checked="UpdatePreference_Changed" Unchecked="UpdatePreference_Changed"/>
                                        <TextBlock Text="Seus presets, atalhos e backups serão incluídos em um backup antes da instalação." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,15,0,0" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,16,0,0">
                                            <Button x:Name="CheckUpdatesButton" Content="Verificar atualizações" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Click="CheckUpdates_Click"/>
                                            <Button x:Name="DownloadUpdateButton" Content="Baixar atualização" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" IsEnabled="False" Click="DownloadUpdate_Click"/>
                                            <Button x:Name="InstallUpdateButton" Content="Instalar agora" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" IsEnabled="False" Click="InstallUpdate_Click"/>
                                            <Button x:Name="CancelUpdateButton" Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Visibility="Collapsed" Click="CancelUpdate_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}" Tag="4">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{StaticResource AccentBrightBrush}" Margin="0,3,0,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Sobre o Velqora" FontSize="19" FontWeight="SemiBold"/>
                                                <TextBlock Text="Informações do aplicativo." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,16">
                                            <Image Source="/assets/Velqora.png" Width="48" Height="48" Stretch="Uniform" Margin="0,0,16,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="V E L Q O R A" Foreground="{StaticResource AccentBrightBrush}" FontSize="14"/>
                                                <TextBlock Text="{Binding Text, ElementName=InstalledVersionText}" Style="{StaticResource SettingsNoteStyle}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Utilitário configurável de controle de movimento." Style="{StaticResource SettingsNoteStyle}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="Preferências de atualização e atalhos são salvos automaticamente. Ajustes das armas são salvos no preset." Style="{StaticResource SettingsNoteStyle}" Margin="8,8,16,0"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
