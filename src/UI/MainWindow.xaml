<Window x:Class="MacroDoButler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MacroDoButler"
        Icon="/assets/Velqora.png" Title="Velqora" Width="1360" Height="860" MinWidth="1120" MinHeight="700"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" Closed="Window_Closed" SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <local:ForceValueConverter x:Key="ForceValueConverter"/>
        <Style x:Key="SidebarNavigationButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="50" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Padding" Value="16,0,12,0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border x:Name="Indicator" Background="Transparent" CornerRadius="0,3,3,0" />
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding Content}" VerticalAlignment="Center" FontSize="13" FontWeight="{TemplateBinding FontWeight}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#FF1A1A1B" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="#302F2615" /><Setter TargetName="Shell" Property="BorderBrush" Value="#403926" /><Setter TargetName="Indicator" Property="Background" Value="{StaticResource AccentBrightBrush}" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentBrightBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" BorderBrush="#303639" BorderThickness="1" Background="{StaticResource BackgroundBrush}">
        <Border.Effect><DropShadowEffect Color="#D0000000" BlurRadius="34" ShadowDepth="10" Opacity="0.85" /></Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.Background><SolidColorBrush Color="{StaticResource BackgroundColor}" /></Grid.Background>


            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.RowSpan="2" Background="#101517" BorderBrush="#FF292A2B" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="*" /><RowDefinition Height="72" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="22,0,12,0" VerticalAlignment="Center">
                            <Image Source="/assets/Velqora.png" Width="38" Height="38" Stretch="Uniform" />
                            <TextBlock Text="Velqora" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Height="1" Background="#FF292A2B" VerticalAlignment="Bottom" Margin="20,0,16,0" IsHitTestVisible="False" />
                        <StackPanel Grid.Row="1" Margin="10,16,10,0">
                            <ToggleButton x:Name="PresetsNavigationButton" Content="Presets" IsChecked="True" Style="{StaticResource SidebarNavigationButtonStyle}" Click="PresetsNavigation_Click" AutomationProperties.Name="Presets">
                                <ToggleButton.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="19" Height="19"><Canvas Width="24" Height="24"><Path Data="M 4,6 L 20,6 L 20,18 L 4,18 Z M 7,9 L 17,9 M 7,12 L 14,12 M 7,15 L 12,15" Stroke="{StaticResource AccentBrightBrush}" StrokeThickness="1.5" Fill="Transparent" /></Canvas></Viewbox></StackPanel></DataTemplate></ToggleButton.ContentTemplate>
                            </ToggleButton>
                            <ToggleButton x:Name="AdvancedNavigationButton" Content="Avançada" Style="{StaticResource SidebarNavigationButtonStyle}" Click="AdvancedNavigation_Click" AutomationProperties.Name="Avançada">
                                <ToggleButton.ContentTemplate><DataTemplate><TextBlock Text="⌖" FontSize="22" Foreground="{StaticResource AccentBrightBrush}"/></DataTemplate></ToggleButton.ContentTemplate>
                            </ToggleButton>
                            <ToggleButton x:Name="SettingsNavigationButton" Content="Configurações" Style="{StaticResource SidebarNavigationButtonStyle}" Click="SettingsNavigation_Click" AutomationProperties.Name="Configurações">
                                <ToggleButton.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="19" Height="19"><Canvas Width="24" Height="24"><Path Data="M 22.340,10.177 L 22.340,13.823 L 19.727,14.071 L 18.928,16.000 L 20.601,18.023 L 18.023,20.601 L 16.000,18.928 L 14.071,19.727 L 13.823,22.340 L 10.177,22.340 L 9.929,19.727 L 8.000,18.928 L 5.977,20.601 L 3.399,18.023 L 5.072,16.000 L 4.273,14.071 L 1.660,13.823 L 1.660,10.177 L 4.273,9.929 L 5.072,8.000 L 3.399,5.977 L 5.977,3.399 L 8.000,5.072 L 9.929,4.273 L 10.177,1.660 L 13.823,1.660 L 14.071,4.273 L 16.000,5.072 L 18.023,3.399 L 20.601,5.977 L 18.928,8.000 L 19.727,9.929 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent"/><Ellipse Canvas.Left="8.5" Canvas.Top="8.5" Width="7" Height="7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6"/></Canvas></Viewbox></StackPanel></DataTemplate></ToggleButton.ContentTemplate>
                            </ToggleButton>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="20,0,16,18" VerticalAlignment="Bottom">
                            <Border Height="1" Background="#FF292A2B" Margin="0,0,0,12" />
                            <TextBlock Text="PERFIS DE CONTROLE" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Grid.Row="0" Background="#0E1214" BorderBrush="#2D2B27" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,0,14,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="CONTROLE DE PERFIS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                            <Button Content="—" Width="40" Height="34" Style="{StaticResource WindowControlButtonStyle}" FontSize="18" Click="Minimize_Click" />
                            <Button Content="×" Width="40" Height="34" Style="{StaticResource WindowControlButtonStyle}" FontSize="21" Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <local:TrajectoryEditor x:Name="AdvancedPage" Grid.Column="1" Grid.Row="1" Visibility="Collapsed"/>
                <Grid x:Name="MainPage" Grid.Column="1" Grid.Row="1" Margin="28,8,24,20">
                    <Grid.Resources>
                        <Style x:Key="PresetOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="#303639"/>
                        </Style>
                        <Style x:Key="PresetDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Background" Value="#211719"/>
                            <Setter Property="BorderBrush" Value="#71353A"/>
                            <Setter Property="Foreground" Value="#F16C70"/>
                        </Style>
                        <Style x:Key="NewPresetButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F5D184" Offset="0"/>
                                        <GradientStop Color="#D5AB5C" Offset="0.6"/>
                                        <GradientStop Color="#E6C174" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="BorderBrush" Value="#E8C57A"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <Style x:Key="BrowserItemStyle" TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Padding" Value="14"/>
                            <Setter Property="Background" Value="#14191B"/>
                            <Setter Property="BorderBrush" Value="#293034"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Surface" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="#202326"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Surface" Property="BorderBrush" Value="#9F8144"/>
                                                <Setter TargetName="Surface" Property="Background" Value="#29261F"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrightBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <ItemsPanelTemplate x:Key="PresetListPanel">
                            <StackPanel/>
                        </ItemsPanelTemplate>
                        <ItemsPanelTemplate x:Key="PresetGridPanel">
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                        <DataTemplate x:Key="PresetBrowserTemplate">
                            <Grid MinHeight="62">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource PresetOutlineButtonStyle}" Padding="20,0" Height="48" Click="EditBrowserPreset_Click" VerticalAlignment="Center" AutomationProperties.Name="Editar preset">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="19" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Editar" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                        <Style x:Key="ViewModeStyle" TargetType="ToggleButton" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                            <Setter Property="Width" Value="44"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ModeSurface" BorderBrush="#303639" BorderThickness="1" CornerRadius="4" Background="#14191B">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ModeSurface" Property="Background" Value="#353020"/>
                                                <Setter TargetName="ModeSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="ModeSurface" Property="BorderBrush" Value="{StaticResource AccentBrightBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="PresetsPage_PreviewMouseWheel">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="Presets" FontSize="36" FontWeight="SemiBold"/>
                                    <TextBlock Text="Organize e gerencie suas configurações" FontSize="16" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource NewPresetButtonStyle}" MinWidth="170" Click="NewBrowserPreset_Click" Width="194" Height="48" AutomationProperties.Name="Novo preset" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="19" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#201907"/>
                                        <TextBlock Text="Novo preset" FontSize="14" VerticalAlignment="Center" Foreground="#201907"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ComboBox x:Name="GameSelector" Style="{StaticResource ComboStyle}" SelectionChanged="Organization_SelectionChanged" AutomationProperties.Name="Selecionar jogo" Visibility="Collapsed" IsTabStop="False"/>
                            <TextBlock x:Name="GameEmptyText" Text="Nenhum jogo cadastrado. Use Gerenciar jogos para começar." Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Grid Height="420" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="235"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Jogos" FontSize="19" FontWeight="SemiBold" Margin="4,2,0,14"/>
                                        <ListBox x:Name="GamesList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedValuePath="Name" ItemContainerStyle="{StaticResource BrowserItemStyle}" SelectionChanged="GamesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Jogos">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42"/>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="34" Height="38" CornerRadius="4" Background="#242A2D" ClipToBounds="True">
                                                            <Grid>
                                                                <Path Data="M2,6 L6,2 L18,2 L22,6 L24,18 L20,20 L15,15 L9,15 L4,20 L0,18 Z M5,7 L5,13 M2,10 L8,10 M16,8 L16,9 M20,11 L20,12" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" Width="24" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                                <Image Source="{Binding Icon}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Grid.Row="2" Content="Gerenciar jogos" Style="{StaticResource PresetOutlineButtonStyle}" FontSize="14" Padding="16,0" Margin="0,8,0,0" Click="EditCategory_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="28" Height="32" Margin="0,0,10,0">
                                                    <Path x:Name="GameHeaderFallback" Data="M2,6 L6,2 L18,2 L22,6 L24,18 L20,20 L15,15 L9,15 L4,20 L0,18 Z M5,7 L5,13 M2,10 L8,10 M16,8 L16,9 M20,11 L20,12" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="24" Height="20"/>
                                                    <Image x:Name="GameHeaderIcon" Stretch="Uniform"/>
                                                </Grid>
                                                <TextBlock x:Name="PresetBrowserTitle" Text="Presets do jogo" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0" Grid.Column="1"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ToggleButton x:Name="ListViewButton" IsChecked="True" Style="{StaticResource ViewModeStyle}" Click="PresetViewMode_Click" ToolTip="Lista" AutomationProperties.Name="Visualização em lista">
                                                    <Viewbox Width="18" Height="18">
                                                        <Path Data="M2,4 L18,4 M2,10 L18,10 M2,16 L18,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Viewbox>
                                                </ToggleButton>
                                                <ToggleButton x:Name="GridViewButton" Style="{StaticResource ViewModeStyle}" Click="PresetViewMode_Click" ToolTip="Grade" AutomationProperties.Name="Visualização em grade">
                                                    <Viewbox Width="18" Height="18">
                                                        <Path Data="M2,2 L8,2 L8,8 L2,8 Z M12,2 L18,2 L18,8 L12,8 Z M2,12 L8,12 L8,18 L2,18 Z M12,12 L18,12 L18,18 L12,18 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Viewbox>
                                                </ToggleButton>
                                            </StackPanel>
                                        </Grid>
                                        <ListBox x:Name="PresetBrowser" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedValuePath="Name" ItemContainerStyle="{StaticResource BrowserItemStyle}" ItemTemplate="{StaticResource PresetBrowserTemplate}" ItemsPanel="{StaticResource PresetListPanel}" SelectionChanged="PresetBrowser_SelectionChanged" SizeChanged="PresetBrowser_SizeChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="Presets do jogo selecionado"/>
                                        <TextBlock x:Name="PresetEmptyText" Grid.Row="1" Text="Nenhum preset neste jogo. Crie seu primeiro preset." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource CardStyle}" Padding="18,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedPresetTitle" Text="Selecione ou crie um preset" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis"/>
                                        <Button x:Name="DeleteSelectedPresetButton" Style="{StaticResource PresetDeleteButtonStyle}" Click="DeletePreset_Click" Margin="0" Height="48" AutomationProperties.Name="Excluir preset" Grid.Column="1" Padding="12,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="19" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#F16C70"/>
                                                <TextBlock Text="Excluir" FontSize="14" VerticalAlignment="Center" Foreground="#F16C70"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,12"/>
                                    <StackPanel x:Name="SelectedPresetSummary">
                                        <local:PresetMovementSummary x:Name="MovementSummary"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="#303638" BorderThickness="0,0,1,0" Padding="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="Arma primária" FontSize="13"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Viewbox Width="42" Height="22" Margin="0,0,12,0">
                                                        <Path Data="M0,12 L9,12 L13,8 L34,8 L34,6 L38,6 L38,8 L52,8 L52,10 L37,10 L37,14 L30,14 L27,24 L21,23 L23,14 L19,14 L16,21 L12,20 L14,13 L9,14 L3,17 L0,17 Z M20,5 L30,5 L30,7 L20,7 Z" Fill="{Binding Foreground, ElementName=SummaryPrimaryState}"/>
                                                    </Viewbox>
                                                    <TextBlock x:Name="SummaryPrimaryState" Text="Ativada" FontSize="13" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Padding="20,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Arma secundária" FontSize="13"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Viewbox Width="29" Height="22" Margin="0,0,12,0">
                                                        <Path Data="M3,4 L34,4 L36,8 L33,12 L23,12 L17,27 L8,27 L12,13 L6,13 L6,10 L2,10 Z M22,13 L28,13 L28,17 L20,17 L21,15 L26,15 L26,14 L22,14 Z" Fill="{Binding Foreground, ElementName=SummarySecondaryState}"/>
                                                    </Viewbox>
                                                    <TextBlock x:Name="SummarySecondaryState" Text="Desativada" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock x:Name="FeedbackText" Foreground="#7EE2A8" TextWrapping="Wrap" Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Visibility="Collapsed">
                                <Expander x:Name="PresetEditor" Header="Ajustes do preset" Foreground="{StaticResource TextBrush}" Margin="0">
                                    <StackPanel Margin="0,14,0,0">
                                        <TextBlock Text="Nome do preset" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="PresetName" Style="{StaticResource FieldStyle}"/>
                                        <ComboBox x:Name="PresetSelector" Visibility="Collapsed" SelectionChanged="PresetSelector_SelectionChanged"/>
                                        <Grid Margin="0,16,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="PrimaryCard" Style="{StaticResource CardStyle}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
