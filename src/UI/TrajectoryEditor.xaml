<UserControl x:Class="MacroDoButler.TrajectoryEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MacroDoButler">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="28,12,24,20">
  <TextBlock Text="Avançada" FontSize="28" FontWeight="SemiBold"/>
  <TextBlock Text="Editor de trajetória" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,18"/>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Jogo" Margin="0,0,0,6"/><ComboBox x:Name="Games" Style="{StaticResource ComboStyle}" SelectionChanged="GameChanged" AutomationProperties.Name="Jogo da trajetória"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Preset" Margin="0,0,0,6"/><ComboBox x:Name="Profiles" Style="{StaticResource ComboStyle}" SelectionChanged="ProfileChanged" DisplayMemberPath="Label" AutomationProperties.Name="Preset da trajetória"/></StackPanel>
   <StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock Text="Arma" Margin="0,0,0,6"/><ComboBox x:Name="Slot" Style="{StaticResource ComboStyle}" SelectionChanged="SlotChanged" SelectedIndex="0" AutomationProperties.Name="Arma da trajetória"><ComboBoxItem Content="Primária"/><ComboBoxItem Content="Secundária"/></ComboBox></StackPanel>
  </Grid>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><CheckBox x:Name="UseTrajectory" Content="Usar trajetória avançada" Checked="OptionsChanged" Unchecked="OptionsChanged" Foreground="{StaticResource TextBrush}"/><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" AutomationProperties.Name="Ajuda sobre trajetória avançada"><Button.ToolTip><ToolTip><TextBlock Text="Substitui o movimento básico desta arma. Alterações válidas já podem ser testadas antes de salvar. Desfazer permite comparar; Salvar no preset mantém o resultado. Desmarcar usa o básico sem apagar os pontos." TextWrapping="Wrap" MaxWidth="340"/></ToolTip></Button.ToolTip></Button></StackPanel>
  <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
   <Expander x:Name="DrawingSection" Header="Desenhar trajetória" Foreground="{StaticResource AccentBrightBrush}" FontSize="14">
    <local:TrajectoryDrawingEditor x:Name="Drawing" Margin="0,14,0,0"/>
   </Expander>
  </Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="320"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardStyle}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="340"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="⌖  Pré-visualização" FontSize="17" FontWeight="SemiBold"/><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" AutomationProperties.Name="Ajuda sobre a prévia"><Button.ToolTip><ToolTip><TextBlock Text="Mostra o deslocamento acumulado em pixels com escala visual automática. Iniciar, reiniciar e a barra de tempo controlam apenas a animação, sem mover o mouse. A prévia inclui um segundo após o último ponto para mostrar o comportamento final." TextWrapping="Wrap" MaxWidth="340"/></ToolTip></Button.ToolTip></Button></StackPanel>
    <local:TrajectoryPlot x:Name="Plot" Grid.Row="1"/>
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
     <WrapPanel><Button x:Name="Play" Content="Iniciar" Click="PlayClick" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Reiniciar" Click="RestartClick" Style="{StaticResource SecondaryButtonStyle}"/><TextBlock x:Name="Clock" Margin="14,0,0,0" VerticalAlignment="Center"/></WrapPanel>
     <Slider x:Name="Scrub" Minimum="0" Maximum="1000" ValueChanged="ScrubChanged" Margin="0,12,0,0" AutomationProperties.Name="Tempo da prévia"/>
     <TextBlock x:Name="TrajectoryMetrics" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"/>
     <TextBlock x:Name="Velocity" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource AccentBrightBrush}"/>
    </StackPanel>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16"><StackPanel>
    <StackPanel Orientation="Horizontal"><TextBlock Text="ϟ  Linha do tempo" FontSize="17" FontWeight="SemiBold"/><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" AutomationProperties.Name="Ajuda sobre a linha do tempo"><Button.ToolTip><ToolTip><TextBlock Text="Selecione um ponto no gráfico ou na linha do tempo. Arraste os marcadores para ajustar o tempo. O primeiro ponto começa em 0 ms." TextWrapping="Wrap" MaxWidth="340"/></ToolTip></Button.ToolTip></Button></StackPanel>
    <local:TrajectoryTimeline x:Name="Timeline" Height="76" Margin="0,10,0,8"/>
    <StackPanel Orientation="Horizontal" Margin="0,18,0,10"><TextBlock Text="◇  Ponto selecionado" FontSize="15"/><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" AutomationProperties.Name="Ajuda sobre os valores do ponto"><Button.ToolTip><ToolTip><TextBlock Text="Edite apenas este ponto. Na vertical, uma unidade equivale a 100 px/s; na lateral, a 10 px/s. Horizontal positivo move à direita; vertical positivo move para baixo. Use zero nos dois eixos para uma fase parada." TextWrapping="Wrap" MaxWidth="340"/></ToolTip></Button.ToolTip></Button></StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/></Grid.RowDefinitions>
     <TextBlock Text="Tempo (ms)" VerticalAlignment="Center"/><TextBox x:Name="PointTime" Grid.Column="1" Style="{StaticResource FieldStyle}" TextChanged="PointTextChanged" AutomationProperties.Name="Tempo em milissegundos"/>
     <TextBlock Grid.Row="1" Text="Horizontal" VerticalAlignment="Center"/><TextBox x:Name="PointX" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldStyle}" TextChanged="PointTextChanged" AutomationProperties.Name="Movimento horizontal"/>
     <TextBlock Grid.Row="2" Text="Vertical" VerticalAlignment="Center"/><TextBox x:Name="PointY" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldStyle}" TextChanged="PointTextChanged" AutomationProperties.Name="Movimento vertical"/>
    </Grid>
    <WrapPanel Margin="0,12,0,14"><Button Content="Adicionar ponto" Click="AddClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button x:Name="Remove" Content="Remover" Click="RemoveClick" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Interpolação"/><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" AutomationProperties.Name="Ajuda sobre interpolação"><Button.ToolTip><ToolTip><TextBlock x:Name="InterpolationHelp" Text="" TextWrapping="Wrap" MaxWidth="340"/></ToolTip></Button.ToolTip></Button></StackPanel><ComboBox x:Name="Interpolation" Style="{StaticResource ComboStyle}" SelectedIndex="0" SelectionChanged="OptionsChanged" AutomationProperties.Name="Interpolação"><ComboBoxItem Content="Linear"/><ComboBoxItem Content="Suave"/><ComboBoxItem Content="Em degraus"/></ComboBox>
    <StackPanel Orientation="Horizontal" Margin="0,12,0,6"><TextBlock Text="Ao terminar"/><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" AutomationProperties.Name="Ajuda sobre o comportamento final"><Button.ToolTip><ToolTip><TextBlock x:Name="EndingHelp" Text="" TextWrapping="Wrap" MaxWidth="340"/></ToolTip></Button.ToolTip></Button></StackPanel><ComboBox x:Name="Ending" Style="{StaticResource ComboStyle}" SelectedIndex="0" SelectionChanged="OptionsChanged" AutomationProperties.Name="Comportamento final"><ComboBoxItem Content="Parar"/><ComboBoxItem Content="Manter último valor"/></ComboBox>
   </StackPanel></Border>
  </Grid>
  <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel><Button Content="Desfazer" Click="UndoClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/><Button Content="Restaurar salvo" Click="RestoreClick" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel><Button Grid.Column="1" Content="Salvar no preset" Click="SaveClick" Style="{StaticResource PrimaryButtonStyle}"/></Grid>
  <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource AccentBrightBrush}"/>
 </StackPanel></ScrollViewer>
</UserControl>
